# First setup: cp .env.example .env
# Build explicitly with ./preview.sh build, install with ./hako npm install,
# then ./preview.sh start. Preview starts Web only; no sync-server credentials.
HAKO_IMAGE=luna-dev:node22-playwright-1.63.0
# Trusted-LAN publishing; use 127.0.0.1 to restrict access to this host.
HAKO_BIND_HOST=0.0.0.0
# Host port 0 requests a Docker-assigned port. Keep the container port nonzero.
WEB_HOST_PORT=4173
WEB_CONTAINER_HOST=0.0.0.0
WEB_CONTAINER_PORT=4173
# Optional known reachable hostname/IP. No automatic network-interface guessing.
WEB_LAN_HOST=
PREVIEW_READY_TIMEOUT=30

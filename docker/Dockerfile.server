FROM minio/minio:RELEASE.2025-09-07T16-13-09Z@sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e AS minio

FROM node:22.22.0-bookworm-slim AS node-base

FROM node-base AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY tsconfig.json tsconfig.server.json ./
COPY src/server ./src/server
COPY src/shared ./src/shared
RUN npm run server:build
COPY deploy/server-runtime-package.mjs ./deploy/server-runtime-package.mjs
RUN node deploy/server-runtime-package.mjs \
    && npm prune --omit=dev --ignore-scripts --no-audit --no-fund

FROM node-base AS bucket-init
COPY --from=minio /usr/bin/mc /usr/local/bin/mc
COPY deploy/bucket-init.mjs /init/bucket-init.mjs
USER 1000:1000
ENTRYPOINT ["node", "/init/bucket-init.mjs"]

FROM node-base AS api
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist/server ./dist/server
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/readyz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "dist/server/server/main.js"]

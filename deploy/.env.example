# Copy to repository-root .env. This file contains no passwords.
LUNA_BIND_HOST=127.0.0.1
LUNA_PORT=8080
# Exact browser origins, without paths or trailing slashes. https://localhost is Android.
LUNA_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,https://localhost
# Set true only for a trusted RFC1918 IPv4 LAN HTTP deployment; HTTPS remains the default.
LUNA_ALLOW_INSECURE_LAN=false
# Optional: point the same Compose project at a restored data directory.
LUNA_DATA_PATH=./data
# The data directory is mounted from ./data and is owned by this UID/GID.
# Change these only when the host bind mount must use another unprivileged user.
LUNA_UID=1000
LUNA_GID=1000

#!/usr/bin/env bash
# hako - Run Luna development commands inside a disposable Node 22 browser container.
#
# One-shot examples:
#   ./hako npm install
#   ./hako npm run typecheck
#   ./hako npm test
#   ./hako npm run build
#   ./hako npm run test:web
#
# The repository is mounted at /app and npm's HOME/cache is kept in .devhome.
# The first command builds the Dockerfile dev stage, which provides Google
# Chrome and Playwright Firefox. Override HAKO_IMAGE to use another image.
# A future web service can use the configurable port mapping below.
set -Eeuo pipefail

# The development image retains Node 22 and adds the browsers needed by
# Playwright. It also includes Python and a C/C++ toolchain for Electron's ABI
# rebuild of better-sqlite3 during packaging.
readonly DEFAULT_IMAGE="luna-dev:node22-playwright-1.63.0"
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly REPO_ROOT
readonly DEVHOME="${REPO_ROOT}/.devhome"
readonly DEV_DOCKERFILE="${REPO_ROOT}/Dockerfile"
readonly IMAGE="${HAKO_IMAGE:-${DEFAULT_IMAGE}}"
STEP_INDEX=0

# Editable defaults. Override temporarily when another local service uses the port.
HAKO_BIND_HOST="${HAKO_BIND_HOST:-127.0.0.1}"
WEB_HOST_PORT="${WEB_HOST_PORT:-5173}"
WEB_CONTAINER_PORT="${WEB_CONTAINER_PORT:-5173}"

usage() {
	printf 'Usage: %s [command [argument ...]]\n' "${BASH_SOURCE[0]##*/}" >&2
	printf '\nRun one project command in %s.\n' "${IMAGE}" >&2
	printf 'Examples:\n  %s npm install\n  %s npm test\n' "${BASH_SOURCE[0]##*/}" "${BASH_SOURCE[0]##*/}" >&2
}

quote_command() {
	local arg

	for arg in "$@"; do
		printf '%q ' "${arg}"
	done
}

log_step() {
	local label=$1
	shift

	STEP_INDEX=$((STEP_INDEX + 1))
	printf '#%s [hako %s] %s\n' "${STEP_INDEX}" "${label}" "$(quote_command "$@")" >&2
}

require_command() {
	command -v "$1" >/dev/null 2>&1 || {
		printf '[hako] required command not found: %s\n' "$1" >&2
		exit 127
	}
}

run_step() {
	local label=$1
	shift

	log_step "${label}" "$@"
	"$@"
}

ensure_image() {
	[[ -n "${HAKO_IMAGE:-}" ]] && return 0
	if docker image inspect "${IMAGE}" >/dev/null 2>&1; then
		return 0
	fi

	[[ -f "${DEV_DOCKERFILE}" ]] || {
		printf '[hako] development Dockerfile not found: %s\n' "${DEV_DOCKERFILE}" >&2
		return 1
	}
	run_step build docker build --progress=plain --target dev --tag "${IMAGE}" \
		--file "${DEV_DOCKERFILE}" "${REPO_ROOT}"
}

main() {
	local -a tty_flags=()
	local -a port_flags=()
	local -a docker_command

	if [[ $# -eq 0 || "$1" == '--help' || "$1" == '-h' ]]; then
		usage
		[[ $# -eq 0 ]] && return 2
		return 0
	fi

	require_command docker
	require_command id
	require_command mkdir
	run_step internal mkdir -p -- "${DEVHOME}"
	ensure_image

	[[ -t 0 ]] && tty_flags+=(-i)
	[[ -t 0 && -t 1 ]] && tty_flags+=(-t)

	case "${HAKO_SERVICE:-}" in
	'') ;;
	browser | web)
		port_flags=(-p "${HAKO_BIND_HOST}:${WEB_HOST_PORT}:${WEB_CONTAINER_PORT}")
		;;
	*)
		printf '[hako] unknown service for port mapping: %s\n' "${HAKO_SERVICE}" >&2
		return 2
		;;
	esac

	docker_command=(
		docker run --rm --init
		"${tty_flags[@]}"
		--user "$(id -u):$(id -g)"
		-e HOME=/app/.devhome
		-v "${REPO_ROOT}:/app"
		-w /app
		--label "hako.repo=${REPO_ROOT}"
		--label "hako.scope=${HAKO_SCOPE:-manual}"
		--label "hako.service=${HAKO_SERVICE:-}"
		"${port_flags[@]}"
		"${IMAGE}"
		"$@"
	)

	log_step run "${docker_command[@]}"
	exec "${docker_command[@]}"
}

main "$@"
